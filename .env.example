# Copy this file to .env and provide endpoints, model names, and credentials.
# Do not commit .env.

# Planner and failure-analysis model.
PLANNER_BASE_URL=http://xxx/v1
PLANNER_MODEL=claude-sonnet-4-5-20250929
PLANNER_API_KEY=fake_key

# Rewrite-skill model. Configure independently from PLANNER_*.
SKILL_BASE_URL=http://xxx/v1
SKILL_MODEL=your-rewrite-model
SKILL_API_KEY=fake_key

# Target model under test.
TARGET_BASE_URL=http://xxx/v1
TARGET_MODEL=gpt-5.4
TARGET_API_KEY=fake_key

# Guard model that judges target responses.
GUARD_BASE_URL=http://xxx/v1
GUARD_MODEL=gpt-4o
GUARD_API_KEY=fake_key

# Optional: classify seed prompts that do not include risk_category.
RISK_CLASSIFIER_BASE_URL=
RISK_CLASSIFIER_MODEL=
RISK_CLASSIFIER_API_KEY=

# Optional: embedding backend for rigorous external-skill extraction and
# semantic deduplication.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Optional external-source discovery credentials.
BOCHA_BASE_URL=
BOCHA_API_KEY=
SERPAPI_API_KEY=
GITHUB_TOKEN=
HF_TOKEN=

# Optional comma-separated proxy bypass hosts for private deployments.
SKILLTEAMING_NO_PROXY=
